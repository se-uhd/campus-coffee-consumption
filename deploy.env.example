# Copy to deploy.prod.env (gitignored) and fill in before deploying to Cloud Run. deploy.prod.env is the
# local source of truth for both the deployment secrets and the non-secret config. scripts/deploy.sh reads
# it, SYNCS the five secrets into Google Secret Manager (creating each, or adding a new version when the
# value changes), builds and pushes the image, and applies the OpenTofu definition in infra/, which binds the
# secrets onto the service by name and passes the non-secret config as environment variables. So the
# editable copy stays on your machine, the runtime reads the secrets from Secret Manager, and no secret
# value ever passes through OpenTofu. See doc/adr/002-declarative-cloud-setup.md,
# doc/2026-06-25_secret-manager-for-deployment-secrets.md, and the README.

# === Secrets (synced from here into Secret Manager by the deploy) ===
#
# Each `Generate:` line below prints a value: REPLACE the placeholder on the key's line with it rather than
# appending a second line. The deploy script reads the first occurrence of a key and refuses to run when a
# key appears twice, so an appended line would either be ignored or stop the deploy.

# HMAC signing secret for admin JWTs. Required, at least 32 bytes. Secret Manager secret: jwt-secret.
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_ME

# RSA private key (PKCS#8 PEM) that decrypts the login payload; the SPA encrypts with the matching public key.
# Required, at least 2048 bits. May be a normal multi-line PEM (the app also turns literal `\n` into newlines).
# Secret Manager secret: login-key.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# (a multi-line value is fine: put the first PEM line after the `=` and the rest on the lines below)
LOGIN_PRIVATE_KEY_PEM=REPLACE_ME

# AES key that encrypts admin two-factor (TOTP) secrets at rest. Required in prod (the app fails fast on the
# committed dev default). Must be the same value on every instance, and must not change once admins have
# enrolled (rotating it invalidates every stored secret and forces re-enrollment). Secret Manager secret:
# totp-encryption-key.
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=REPLACE_ME

# Password of the DB_USERNAME role below. Required. Secret Manager secret: db-app-password. The Cloud SQL
# instance enforces a password policy (infra/sql.tf): at least 8 characters with a lowercase letter, an
# uppercase letter, a digit, and a symbol, so a plain hex string is refused.
# Generate: scripts/generate-password.sh
DB_PASSWORD=REPLACE_ME

# Password of the Cloud SQL instance's `postgres` user (its administrator). Used only by hand, as the
# administrator, through the Cloud SQL Auth Proxy to provision the app role or to inspect the database. It is
# never bound to the app and not synced anywhere. Generate: scripts/generate-password.sh, then set it with
# `gcloud sql users set-password postgres --instance <instance> --prompt-for-password` and record it here.
DB_SUPERUSER_PASSWORD=REPLACE_ME

# First-admin password, used once on a fresh database to create the initial admin (no fixtures in prod).
# Required, at least 24 characters with a lowercase letter, an uppercase letter, and a digit.
# Secret Manager secret: bootstrap-admin-password. Generate: scripts/generate-password.sh
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME

# Passphrase that encrypts the OpenTofu state and plan files (infra/encryption.tf). The encrypted state is
# committed to git, so this is what keeps the deploy identifiers in it unreadable. At least 16 characters.
# Losing it means re-adopting the resources through infra/imports.tf (delete the state, run tofu plan).
# Generate: openssl rand -hex 32
STATE_PASSPHRASE=REPLACE_ME

# === Non-secret config (exported to OpenTofu as TF_VAR_* by scripts/deploy.sh) ===

# The Google Cloud project, the region of the Cloud Run service, the Cloud SQL instance, and the image
# repository, and the Cloud SQL instance's name and zone. The connection name the prod profile needs
# (project:region:instance) is derived from these.
GCP_PROJECT=your-project-id
GCP_REGION=your-region
SQL_INSTANCE=your-instance
SQL_ZONE=your-region-a

# Database role the app runs as: the least-privilege role provisioned once with scripts/sql/create-app-role.sql
# (see the README). DB_PASSWORD above is this role's password.
DB_USERNAME=campus_coffee_app

# Recipient of the uptime alert on /actuator/health. Leave empty to create no uptime check and no alert.
ALERT_EMAIL=

# Public https origin the app is reached at (the Cloud Run service URL or a custom domain). The capability
# QR/login URLs are built from it, so it must be the real https URL. Prod refuses to start without it. On a
# fresh project, deploy once with a placeholder, read the URL from the deploy's "Service URL" line, put it
# here, and deploy again.
CAMPUS_COFFEE_APP_BASE_URL=https://pending.invalid

# First-admin identity (the password is BOOTSTRAP_ADMIN_PASSWORD above). FIRST_NAME / LAST_NAME are optional.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@se.uni-heidelberg.de
BOOTSTRAP_ADMIN_FIRST_NAME=Bootstrap
BOOTSTRAP_ADMIN_LAST_NAME=Admin
